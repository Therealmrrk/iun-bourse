# ─────────────────────────────────────────────────────────────
#  IUN SCHOLARSHIP PORTAL — ENVIRONMENT VARIABLES
#  Copy this file to .env.local and fill in every value.
#  NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────────

# SUPABASE — get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# RESEND — get this from: resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# ✏️ EDIT: The email address that receives payment notifications
ADMIN_NOTIFICATION_EMAIL=admin@iun.tg

# ✏️ EDIT: The "From" address for automated emails (must be verified in Resend)
EMAIL_FROM=Bourse IUN <bourse@iun.tg>

# ✏️ EDIT: IUN WhatsApp number (international format, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=+22893001111

# ✏️ EDIT: TMoney payment details
NEXT_PUBLIC_TMONEY_NAME=NOM DU COMPTE TMONEY
NEXT_PUBLIC_TMONEY_NUMBER=XXXXXXXXXX

# Portal URL (change to https://bourse.iun.tg in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
